---
interface Props {
  id: string;
  title: string;
  cover: string;
  duration?: string;
  description?: string;
  titleWithPinyin?: string;
}

const { id, title, cover, duration, description, titleWithPinyin } = Astro.props;
const baseUrl = import.meta.env.BASE_URL || '/';
const coverUrl = cover.startsWith('/') ? cover : `${baseUrl}/${cover}`;
---

<article class="story-card">
  <a href={baseUrl ? `${baseUrl}/story/${id}` : `/story/${id}`} class="card-link">
    <div class="cover-wrapper">
      <img src={coverUrl} alt={title} loading="lazy" />
    </div>
    <div class="card-content">
      <h3 class="title title-normal">{title}</h3>
      <h3 class="title title-pinyin" style="display: none;" set:html={titleWithPinyin || title} />
      {duration && (
        <div class="meta">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 6v6l4 2"/>
          </svg>
          <span>{duration}</span>
        </div>
      )}
    </div>
  </a>
</article>

<style>
  .story-card {
    background: var(--color-card);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    width: 100%;  /* 确保卡片填满网格单元 */
  }
  
  .story-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  
  .card-link {
    display: block;
  }
  
  .cover-wrapper {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(184, 169, 201, 0.1), rgba(245, 208, 197, 0.1));
  }
  
  .cover-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    transition: transform 0.5s ease;
  }
  
  .story-card:hover .cover-wrapper img {
    transform: scale(1.05);
  }
  
  .card-content {
    padding: 1.25rem;
    text-align: center;
  }
  
  .title {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.5rem;
    line-height: 1.4;
    min-height: 1.6rem;
  }
  
  .title-pinyin {
    font-size: 1.1rem;
    line-height: 1.6;
  }
  
  .title-pinyin :global(.pinyin-ruby) {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    vertical-align: bottom;
    margin: 0 1px;
    line-height: 1.3;
  }
  
  .title-pinyin :global(.pinyin-ruby rb) {
    font-size: 1.1rem;
  }
  
  .title-pinyin :global(.pinyin-ruby rt) {
    font-size: 0.75rem;
    color: var(--color-accent-dark);
    font-weight: 500;
    margin-bottom: 2px;
  }
  
  .meta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-accent);
  }
  
  .meta svg {
    opacity: 0.7;
  }
</style>
