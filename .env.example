# ====================================
# 巫巫女故事自动化生成工具 - 环境变量配置
# ====================================
# 复制此文件为 .env 并填写实际的 API 密钥
# 命令: cp .env.example .env

# ====================================
# MiniMax TTS 配置（推荐）
# ====================================
# 获取地址: https://www.minimaxi.com/user-center/basic-information/interface-key
# - API Key: 用户中心 → 接口密钥 → 创建新的 API Key
#   支持两种类型：pay-as-you-go（按量付费）或 coding plan（套餐）
#   注意：需要 pay-as-you-go 类型，因为 coding plan 不支持语音功能
MINIMAX_API_KEY=your_minimax_api_key_here

# MiniMax 统一音色配置（所有角色使用同一个音色）
# 使用 python scripts/clone_voice.py list 查看可用音色
# 或访问 https://www.minimaxi.com/audio 管理你的音色
MINIMAX_VOICE_ID=wuwunv_gentle_taozi  # 已克隆的温柔女巫音色
MINIMAX_EMOTION=gentle  # 情感: gentle（温柔）, happy（欢快）, sad（悲伤）等

# ====================================
# 火山引擎 API 配置（用于封面生成）
# ====================================

# 方式 A：使用 Access Key + Secret Key
# 获取地址: https://console.volcengine.com/iam/keymanage
# VOLCENGINE_ACCESS_KEY=your_access_key_here
# VOLCENGINE_SECRET_KEY=your_secret_key_here

# 方式 B：使用 APP ID + Access Token（推荐）
# 获取地址: https://console.volcengine.com/speech/service
VOLCENGINE_APP_ID=your_app_id_here
VOLCENGINE_ACCESS_TOKEN=your_access_token_here

# ====================================
# 即梦 AI 配置
# ====================================
# 即梦 AI 模型名称
JIMENG_MODEL=jimeng-4.0

# 图像尺寸: 1024*1020, 1080*1920 等
IMAGE_SIZE=1024*1020

# 图像质量: standard, high
IMAGE_QUALITY=high

# 参考图权重（0.0 - 1.0，越高越严格保持角色特征）
REFERENCE_WEIGHT=0.8
