# ====================================
# 巫巫女故事自动化生成工具 - 环境变量配置
# ====================================
# 复制此文件为 .env 并填写实际的 API 密钥
# 命令: cp .env.example .env

# ====================================
# 火山引擎 API 配置（两种认证方式二选一）
# ====================================

# 方式 A：使用 Access Key + Secret Key
# 获取地址: https://console.volcengine.com/iam/keymanage
# VOLCENGINE_ACCESS_KEY=your_access_key_here
# VOLCENGINE_SECRET_KEY=your_secret_key_here

# 方式 B：使用 APP ID + Access Token（推荐）
# 获取地址: https://console.volcengine.com/speech/service
VOLCENGINE_APP_ID=your_app_id_here
VOLCENGINE_ACCESS_TOKEN=your_access_token_here

# ====================================
# 豆包 TTS 配置
# ====================================
# 音色类型（运行 python scripts/get_tts_voices.py 查看完整列表）
# 常用音色：
#   - S_ieReLKSR1: 温柔桃子（复刻）
#   - zh_female_tianmeitaozi_mars_bigtts: 甜美桃子
#   - zh_female_vv_mars_bigtts: Vivi
TTS_VOICE_TYPE=S_ieReLKSR1

# ====================================
# 即梦 AI 配置
# ====================================
# 即梦 AI 模型名称
JIMENG_MODEL=jimeng-4.0

# 图像尺寸: 1024*1020, 1080*1920 等
IMAGE_SIZE=1024*1020

# 图像质量: standard, high
IMAGE_QUALITY=high

# 参考图权重（0.0 - 1.0，越高越严格保持角色特征）
REFERENCE_WEIGHT=0.8