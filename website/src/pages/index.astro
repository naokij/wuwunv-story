---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import StoryCard from '../components/StoryCard.astro';
import Pagination from '../components/Pagination.astro';
import storiesData from '../data/stories.json';

const baseUrl = import.meta.env.BASE_URL || '/wuwunv-story';
const STORIES_PER_PAGE = 6;  // 6是2和3的最小公倍数，确保任何设备上都是整数行

// 按ID排序（01, 02, 03...）
const sortedStories = storiesData.stories.sort((a, b) => {
  const numA = parseInt(a.id.split('-')[0]);
  const numB = parseInt(b.id.split('-')[0]);
  return numA - numB;
});

// 分页
const currentPage = 1;
const totalPages = Math.ceil(sortedStories.length / STORIES_PER_PAGE);
const stories = sortedStories.slice(0, STORIES_PER_PAGE);
---

<Layout title="巫巫女睡前故事集 - 温暖每一个梦境">
  <Header />
  
  <main>
    <!-- Hero 区域 -->
    <section class="hero">
      <div class="hero-content">
        <h1 class="hero-title">巫巫女睡前故事集</h1>
        <p class="hero-subtitle">温暖每一个梦境，陪伴孩子入眠的奇妙旅程。</p>
        <p class="hero-desc">在这里，每一个故事都是一颗闪耀的星星。</p>
        <div class="hero-stats">
          <span class="stat">{sortedStories.length} 个故事</span>
          <span class="stat-dot">·</span>
          <span class="stat">适合 6 岁+</span>
          <span class="stat-dot">·</span>
          <span class="stat">睡前阅读</span>
        </div>
      </div>
    </section>
    
    <!-- 故事列表 -->
    <section class="stories-section">
      <div class="container">
        <div class="stories-grid">
          {stories.map((story) => (
            <StoryCard
              id={story.id}
              title={story.title}
              titleWithPinyin={story.titleWithPinyin}
              cover={story.cover}
              duration={story.duration}
            />
          ))}
        </div>
        
        <Pagination
          currentPage={currentPage}
          totalPages={totalPages}
          baseUrl={baseUrl}
        />
      </div>
    </section>
    
    <!-- 页脚 -->
    <footer class="footer">
      <div class="footer-content">
        <p class="footer-quote">「晚安，好梦。」</p>
        <p class="footer-copy">© 2026 巫巫女睡前故事集 · 江乐</p>
        <a href="https://github.com/naokij/wuwunv-story" target="_blank" rel="noopener" class="github-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          GitHub
        </a>
      </div>
    </footer>
  </main>
</Layout>

<style>
  .hero {
    padding: 4rem 2rem 3rem;
    text-align: center;
  }
  
  .hero-content {
    max-width: 600px;
    margin: 0 auto;
  }
  
  .hero-title {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  
  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--color-text);
    opacity: 0.8;
    margin-bottom: 0.5rem;
  }
  
  .hero-desc {
    font-size: 1rem;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
  }
  
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--color-text);
    opacity: 0.6;
  }
  
  .stat-dot {
    opacity: 0.5;
  }
  
  .stories-section {
    padding: 1rem 2rem 2rem;
  }
  
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .stories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  
  @media (max-width: 1024px) {
    .stories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 640px) {
    .hero {
      padding: 3rem 1.5rem 2rem;
    }
    
    .hero-title {
      font-size: 2rem;
    }
    
    .stories-section {
      padding: 1rem 1rem 2rem;
    }
    
    .stories-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .hero-stats {
      flex-wrap: wrap;
    }
  }
  
  .footer {
    padding: 4rem 2rem;
    text-align: center;
    border-top: 1px solid var(--color-border);
  }
  
  .footer-content {
    max-width: 600px;
    margin: 0 auto;
  }
  
  .footer-quote {
    font-size: 1.1rem;
    color: var(--color-accent);
    margin-bottom: 1rem;
    font-style: italic;
  }
  
  .footer-copy {
    font-size: 0.85rem;
    color: var(--color-text);
    opacity: 0.6;
    margin-bottom: 0.75rem;
  }
  
  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-accent);
    transition: opacity 0.2s;
  }
  
  .github-link:hover {
    opacity: 0.8;
  }
</style>
